{
  "model": "bikeshare-coder",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_API_KEY": "",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_raw.sh",
            "timeout": 10,
            "statusMessage": "Checking the command does not write into data/raw/..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_leakage.sh",
            "timeout": 60,
            "statusMessage": "Re-running leakage tests..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_gate.sh",
            "timeout": 120,
            "statusMessage": "Running the test suite before finishing..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m src.:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ],
    "deny": [
      "Write(./data/raw/**)",
      "Edit(./data/raw/**)",
      "Bash(rm -rf:*)"
    ]
  }
}
